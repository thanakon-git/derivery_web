# ========================================================
# Database & Server Configuration
# ========================================================
PORT=3000

# --------------------------------------------------------
# Option 1: Aiven Cloud MySQL (Service URI)
# ก๊อปปี้ Service URI จากหน้า Aiven Console มาวางได้เลย:
# --------------------------------------------------------
# MYSQL_URL=mysql://avnadmin:your_password@mysql-xxxxx.aivencloud.com:12345/defaultdb?ssl-mode=REQUIRED

# --------------------------------------------------------
# Option 2: Aiven หรือ Local MySQL (กรอกแยกทีละค่า)
# --------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=defaultdb
DB_SSL=false

# --------------------------------------------------------
# CORS: กำหนด Origin ที่อนุญาต (ถ้าไม่กำหนดจะอนุญาต * ทุก origin)
# production: ALLOWED_ORIGIN=https://your-frontend.vercel.app
# --------------------------------------------------------
# ALLOWED_ORIGIN=http://localhost:4200
